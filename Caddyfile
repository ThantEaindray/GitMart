# Reverse proxy for the production deploy. Caddy terminates TLS (automatic,
# free certs via Let's Encrypt — no manual cert management) and forwards to
# the app container over the internal compose network.
#
# WebSocket upgrade requests go to the raw `ws` server (WS_PORT, see
# server.js); everything else goes to the main Express app. Both live behind
# the same domain so the browser only ever talks to one origin.
#
# Everything below is wrapped in one `route` block. A prior version of this
# file relied on `handle`/`handle_path` instead, on the assumption that
# Caddy's documented "sort handle blocks by matcher specificity" behaviour
# would put handle_path /imgs/* ahead of the bare catch-all handle. In
# production it didn't: every request, /imgs/* included, kept landing on
# app:3000 (confirmed via curl — Caddy's own `Via` header showed it had
# processed the request, but handed it to the app rather than the image
# host). `route` sidesteps the whole question: it disables Caddy's automatic
# directive sorting entirely for anything nested inside it and guarantees
# strict, literal, top-to-bottom evaluation — first matching entry wins, no
# exceptions, nothing to get subtly wrong.
kab1oiee.com, www.kab1oiee.com {
	@websockets {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	route {
		reverse_proxy @websockets app:3001

		# The uploaded-image host (SCP_IP) only serves plain HTTP. Proxying it
		# under our own HTTPS origin means the browser never has to load an
		# http:// subresource from an https:// page — see the matching
		# comment on buildPublicImageUrl in image.controller.js. handle_path
		# strips the /imgs prefix before forwarding, since the image host
		# serves files at its own root. Nesting it inside `route` is safe —
		# route treats it as one literal step in the sequence, same as any
		# other directive here.
		handle_path /imgs/* {
			reverse_proxy 152.53.200.138:80
		}

		reverse_proxy app:3000
	}
}
