# ─────────────────────────────────────────────────────────
#  Environment template — NAMES ONLY, never real values.
#  Copy to .env.dev and fill in. .env* is gitignored except
#  this file, so real secrets can never be committed.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/gitmart
PORT=3000

# ── Auth ──────────────────────────────────────────────────
BCRYPT_PEPPER=
JWT_SECRET_KEY=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=15m
JWT_REFRESH_REMEMBER_TTL=7d
JWT_REFRESH_NO_REMEMBER_TTL=1d

# ── Image hosting (chat images, listing cover photos) ─────
#  Uploaded files are SCP'd to a shared host that only serves
#  plain HTTP. PUBLIC_IMAGE_BASE_URL is optional: leave it
#  empty in dev, where the app itself isn't served over HTTPS
#  so a direct http://SCP_IP URL is fine. In production, point
#  it at Caddy's /imgs/* proxy route (e.g.
#  https://your-domain.com/imgs) so the browser never has to
#  load an http:// image from an https:// page.
SCP_IP=
SCP_USR=
SCP_PWD=
SCP_PORT=22
SCP_DIR=
PUBLIC_IMAGE_BASE_URL=

# ── Reservation expiry ─────────────────────────────────────
#  A RESERVED listing whose buyer never checks out is released back to
#  AVAILABLE automatically after RESERVATION_HOLD_HOURS, by a background
#  sweep that runs every RESERVATION_SWEEP_INTERVAL_MS. Both optional —
#  defaults are 24 hours and 15 minutes (see reservationExpirySweep.js).
RESERVATION_HOLD_HOURS=24
RESERVATION_SWEEP_INTERVAL_MS=900000

# ── AI image analysis ─────────────────────────────────────
GEMINI_API_KEY=

# ── Email notifications (optional) ────────────────────────
#  Leave SMTP_HOST empty to disable email. The app still runs
#  normally — notifications are saved and pushed over SSE, the
#  send is simply skipped.
#
#  Gmail: enable 2FA, then create an App Password
#         (https://myaccount.google.com/apppasswords)
#         and use that as SMTP_PASS. Your normal account
#         password will not work.
#
#  Port 465 = implicit TLS, port 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GitMart <no-reply@gitmart.local>

# Used to build the "View in GitMart" link inside emails.
APP_URL=http://localhost:3000
